# The relay between the technical Telegram channel and the GitHub runs: `lexinform listen`.
# Install: cp deploy/lexinform-listen.service /etc/systemd/system/ && systemctl daemon-reload
#          && systemctl enable --now lexinform-listen
# Logs:    journalctl -u lexinform-listen -f
# See docs/operator-commands.md for the whole setup.

[Unit]
Description=lexinform: relay operator commands from Telegram to the inbox branch
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/lexinform
# Secrets live in /opt/lexinform/.env (bot token, log channel id, GitHub repo and token).
# The venv's entry point directly, not `uv run`: the wrapper would stay alive as the parent
# process for nothing, costing ~25 MB on a 384 MB box. deploy/update.sh keeps the venv in sync.
ExecStart=/opt/lexinform/.venv/bin/lexinform listen
Restart=always
RestartSec=30
# Without these the default (5 starts in 10 s) is out of reach at a 30 s interval, so a relay
# that dies on every start restarts for ever and never enters `failed`: nothing to alert on, and
# commands sit with Telegram until it drops them after 24 h. Six failures within an hour is a
# relay that is not coming back by itself.
StartLimitIntervalSec=3600
StartLimitBurst=6
# A long poll is 50 s; give a graceful stop time to finish the one in flight.
TimeoutStopSec=70
Environment=PYTHONUNBUFFERED=1
Environment=LEXINFORM_LOG_LEVEL=INFO
# A few dozen MB in practice; the cap keeps a leak from taking the box down.
MemoryMax=150M

[Install]
WantedBy=multi-user.target
