# --- Required ---------------------------------------------------------------
# Anthropic API key, read directly by the anthropic SDK.
ANTHROPIC_API_KEY=

# Telegram bot token from @BotFather. The bot must be an admin of the channel.
LEXINFORM_TELEGRAM_BOT_TOKEN=
# Channel id: @public_channel_name or numeric -100xxxxxxxxxx for private channels.
LEXINFORM_TELEGRAM_CHANNEL_ID=
# Optional technical channel for run reports, warnings and errors (leave empty to disable).
# LEXINFORM_TELEGRAM_LOG_CHANNEL_ID=

# --- Optional (defaults shown) ------------------------------------------------
# LEXINFORM_TERM=10
# LEXINFORM_DB_PATH=./lexinform.db
# LEXINFORM_LLM_MODEL=claude-opus-5
# LEXINFORM_LLM_EFFORT=medium
# LEXINFORM_LLM_TRIAGE_MODEL=claude-sonnet-5
# LEXINFORM_OUTPUT_LANGUAGE=ru
# LEXINFORM_MIN_SCORE=3
# LEXINFORM_MAX_PUBLISH_PER_RUN=10
# LEXINFORM_MAX_ANALYZE_PER_RUN=40
# LEXINFORM_TEXT_BUDGET_CHARS=1500000
# LEXINFORM_SEJM_CONCURRENCY=4
# LEXINFORM_LLM_CONCURRENCY=2
# LEXINFORM_FIRST_RUN_LOOKBACK_DAYS=1
# LEXINFORM_CONSULTATION_REMINDERS=true
# LEXINFORM_CONSULTATION_REMINDER_DAYS=3
# LEXINFORM_IN_FORCE_REMINDERS=true
# LEXINFORM_AGENDA_WATCH=true
# LEXINFORM_RCL_ENABLED=true
# LEXINFORM_RCL_CONCURRENCY=6
# LEXINFORM_LOG_LEVEL=INFO
