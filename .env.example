# --- Required ---------------------------------------------------------------
# Anthropic API key, read directly by the anthropic SDK. Triage always runs on Claude
# (LEXINFORM_LLM_TRIAGE_MODEL); the other four calls default to Claude too for now (paid-off
# budget) — GPT-5.1 is measured and ready (docs/llm-cost.md) but switched on per call only by
# naming it in LEXINFORM_LLM_ANALYSIS_MODEL / _AMENDMENTS_MODEL / _SUPPLEMENT_MODEL / _JOINT_MODEL
# below.
ANTHROPIC_API_KEY=
# OpenAI API key, read directly by the openai SDK. Only needed once one of the four settings
# above is switched to a non-Claude model (gpt-5.1).
OPENAI_API_KEY=

# Telegram bot token from @BotFather. The bot must be an admin of the channel.
LEXINFORM_TELEGRAM_BOT_TOKEN=
# Channel id: @public_channel_name or numeric -100xxxxxxxxxx for private channels.
LEXINFORM_TELEGRAM_CHANNEL_ID=
# Optional technical channel for run reports, warnings and errors (leave empty to disable).
# Operator commands (/analyze 3039, /show, /skip, /republish, /help) are read from it too.
# LEXINFORM_TELEGRAM_LOG_CHANNEL_ID=

# --- Operator commands (docs/operator-commands.md) -----------------------------
# Where a run finds the command files ({update_id}.json); the workflow sets it to the checked-out
# `inbox` branch. Empty: no commands phase.
# LEXINFORM_INBOX_DIR=
# The relay's side (`lexinform listen` on the server): the repository and a fine-grained token
# with Contents read/write on it, the branch the inbox lives in.
# LEXINFORM_GITHUB_REPO=sobolevbel/lexinform
# LEXINFORM_GITHUB_TOKEN=
# LEXINFORM_INBOX_BRANCH=inbox
# LEXINFORM_LISTEN_TIMEOUT_SECONDS=50

# --- Optional (defaults shown) ------------------------------------------------
# Sejm term (kadencja). Empty: the current one from the API, so a new Sejm is picked up by
# itself; set a number only to pin an older term.
# LEXINFORM_TERM=
# LEXINFORM_DB_PATH=./lexinform.db
# LEXINFORM_LLM_EFFORT=medium        # Claude's thinking effort, whichever of the five calls it
# LEXINFORM_LLM_MAX_TOKENS=4000      # Claude's output cap, whichever of the five calls it
# LEXINFORM_LLM_TRIAGE_MODEL=claude-sonnet-5   # always Claude, the gate stays cheap on purpose
# LEXINFORM_LLM_OPENAI_EFFORT=medium     # GPT-5.1's reasoning effort, whichever call it
# LEXINFORM_LLM_OPENAI_MAX_TOKENS=8000   # GPT-5.1's output cap, whichever call it
# LEXINFORM_LLM_ANALYSIS_MODEL=claude-opus-5-5     # the full per-bill analysis; gpt-5.1 measured
# LEXINFORM_LLM_BATCH_ENABLED=false     # analyze()/a re-analysis go through the batch API, half price
# LEXINFORM_LLM_BATCH_PROVIDER=anthropic   # or openai; which batch API LLM_BATCH_ENABLED uses
# LEXINFORM_LLM_BATCH_SYNC_WITHIN_DAYS=3   # pilny, or a consultation ending this soon: no batch
# LEXINFORM_LLM_BATCH_STATE_FILE=state/lexinform.sql  # Git checkpoint on ephemeral runners
# LEXINFORM_LLM_BATCH_STATE_BRANCH=state
# LEXINFORM_LLM_AMENDMENTS_MODEL=claude-opus-5-5   # Senate/committee amendment summaries
# LEXINFORM_LLM_SUPPLEMENT_MODEL=claude-opus-5-5   # filed-document digests (government position, OSR, …)
# LEXINFORM_LLM_JOINT_MODEL=claude-opus-5-5        # jointly-considered-print comparisons
# LEXINFORM_OUTPUT_LANGUAGE=ru
# LEXINFORM_MIN_SCORE=3
# LEXINFORM_MAX_PUBLISH_PER_RUN=10
# LEXINFORM_MAX_ANALYZE_PER_RUN=40
# LEXINFORM_TEXT_BUDGET_CHARS=1500000
# LEXINFORM_MAX_ANALYSIS_COST_USD=2.0
# LEXINFORM_MAX_RUN_COST_USD=15.0
# LEXINFORM_SEJM_CONCURRENCY=4
# LEXINFORM_LLM_CONCURRENCY=2
# LEXINFORM_FIRST_RUN_LOOKBACK_DAYS=1
# LEXINFORM_CONSULTATION_REMINDERS=true
# LEXINFORM_CONSULTATION_REMINDER_DAYS=3
# LEXINFORM_IN_FORCE_REMINDERS=true
# LEXINFORM_AGENDA_WATCH=true
# Where the text of a bill that has no print number yet is served. Its own host because its
# WAF has its own opinion of us; a failure there costs that bill its text and nothing more.
# LEXINFORM_ORKA_BASE_URL=https://orka.sejm.gov.pl
# LEXINFORM_RCL_ENABLED=true
# LEXINFORM_RCL_CONCURRENCY=6
# HTTP forward proxy with an EU address for legislacja.rcl.gov.pl (it drops connections from
# GitHub runners): http://user:password@host:port. Empty: connect directly.
# LEXINFORM_RCL_PROXY_URL=
# LEXINFORM_WYKAZ_ENABLED=true
# The same kind of proxy for www.gov.pl, if a runner cannot reach it either.
# LEXINFORM_WYKAZ_PROXY_URL=
# LEXINFORM_SENATE_ENABLED=true
# The same kind of proxy for www.senat.gov.pl, if a runner cannot reach it.
# LEXINFORM_SENATE_PROXY_URL=
# LEXINFORM_RUNS_RETENTION_DAYS=90
# LEXINFORM_LOG_LEVEL=INFO

# The weekly digest: drafted into the technical channel on this weekday (Warsaw time, 6 is
# Sunday) and published to readers only when the operator presses the button under the draft.
# LEXINFORM_DIGEST_ENABLED=true
# LEXINFORM_DIGEST_WEEKDAY=6
# Where the monthly figures ask for support; both empty say nothing at all.
# LEXINFORM_DIGEST_SUPPORT_URL=
# LEXINFORM_DIGEST_SPONSOR_URL=
