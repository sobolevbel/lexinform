  "fault_plugin_source": "import ast\nimport inspect\nimport os\nimport textwrap\nimport lexinform.services.card_edits as edits\nimport lexinform.services.publications as publications\n\n\ndef pytest_sessionstart(session):\n    fault = os.environ.get('CARD_TEST_FAULT')\n    if not fault:\n        return\n    module = edits if fault.startswith('card_') else publications\n    name = 'edit_card' if module is edits else 'send_publications'\n    original = getattr(module, name)\n    tree = ast.parse(textwrap.dedent(inspect.getsource(original)))\n    function = tree.body[0]\n    if fault == 'card_projection_before_send':\n        index = next(i for i,n in enumerate(function.body) if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='sent' for t in n.targets))\n        function.body[index:index] = ast.parse('repo.set_card_digest(owner.id, desired)').body\n    elif fault == 'card_duplicate_edit_target':\n        nodes = [n for n in ast.walk(function) if isinstance(n,ast.keyword) and n.arg=='edit_message_id']\n        assert len(nodes)==1\n        target = next(n for n in ast.walk(nodes[0]) if isinstance(n,ast.Subscript) and isinstance(n.value,ast.Name) and n.value.id=='targets')\n        target.slice=ast.Constant(value=0)\n    elif fault == 'delivery_uncertain_as_failed':\n        count=0\n        for n in ast.walk(function):\n            if isinstance(n,ast.Attribute) and isinstance(n.value,ast.Name) and n.value.id=='PublicationStatus' and n.attr=='UNKNOWN':\n                n.attr='FAILED';count+=1\n        assert count==1\n    elif fault == 'delivery_pending_checkpoint_after_send':\n        before=next(n for n in function.body if isinstance(n,ast.If) and ast.unparse(n.test)=='checkpoint is not None')\n        function.body.remove(before)\n        attempt=next(n for n in function.body if isinstance(n,ast.Try))\n        attempt.body.insert(1,before)\n    elif fault == 'delivery_receipt_checkpoint_removed':\n        after=function.body[-2]\n        assert isinstance(after,ast.If) and ast.unparse(after.test)=='checkpoint is not None'\n        function.body.remove(after)\n    else:\n        raise ValueError(fault)\n    namespace=dict(vars(module))\n    exec(compile(ast.fix_missing_locations(tree),'<fault:'+fault+'>','exec'),namespace)\n    setattr(module,name,namespace[name])\n",
  "fault_runner_source": "import json\nimport os\nimport subprocess\nfrom pathlib import Path\n\nroots={'before':Path('/private/tmp/lexinform-perf-baseline-20261104'),'after':Path('/Users/sobaleu/.codex/worktrees/test-performance-20261104/lexinform')}\nold='tests/scenario/test_card_edit_multipart.py::test_every_multipart_edit_part_is_remote_before_api_and_final_receipt_alone_advances_card'\nnew='tests/unit/test_card_edit_contracts.py::test_every_multipart_edit_part_is_checkpointed_before_api_and_final_receipt_alone_advances_card'\ntransport='test_multipart_transport_outcomes_preserve_attempts_projection_and_confirmed_message_counts[uncertain-final-many_shrink]'\nfaults={\n 'card_projection_before_send':(old+'[many_grow-on]',new+'[many_grow-on]'),\n 'card_duplicate_edit_target':(old+'[many_grow-on]',new+'[many_grow-on]'),\n 'delivery_uncertain_as_failed':('tests/scenario/test_card_edit_multipart.py::'+transport,'tests/unit/test_card_edit_contracts.py::'+transport),\n 'delivery_pending_checkpoint_after_send':(old+'[single_many-on]',new+'[single_many-on]'),\n 'delivery_receipt_checkpoint_removed':(old+'[single_many-on]',new+'[single_many-on]'),\n}\nrows=[]\nfor fault,tests in faults.items():\n for phase,root in roots.items():\n  node=tests[0 if phase=='before' else 1]\n  env=os.environ.copy();env.update(CARD_TEST_FAULT=fault,PYTHONPATH=os.pathsep.join(['/private/tmp',str(root/'src'),str(root)]))\n  command=[str(root/'.venv/bin/python'),'-m','pytest','-n','0','-p','lexinform_card_faults',node,'--maxfail=1']\n  result=subprocess.run(command,cwd=root,env=env,text=True,capture_output=True)\n  output=result.stdout+result.stderr\n  path=Path('/private/tmp')/f'lexinform-fault-{phase}-{fault}.log';path.write_text(output)\n  row={'phase':phase,'fault':fault,'nodeid':node,'exit_code':result.returncode,'detected':result.returncode==1 and 'AssertionError' in output,'log':str(path)}\n  rows.append(row);print(json.dumps(row),flush=True)\nPath('/private/tmp/lexinform-fault-results.json').write_text(json.dumps(rows,indent=2)+'\\n')\nassert all(r['detected'] for r in rows), 'every fault must fail an assertion, not an import or collection error'\n",
  "assertion_audit_source": "import ast\nimport hashlib\nimport json\nimport subprocess\nfrom pathlib import Path\n\npairs=[('test_document_reviews','test_document_review_evidence'),('test_commission_reviews','test_commission_review_evidence'),('test_all_commission_reviews','test_commission_review_sources'),('test_computation_binding_reader','test_computation_input_binding'),('test_source_context_delivery','test_source_context_delivery')]\nrows=[]\nfor old,new in pairs:\n source=subprocess.check_output(['git','show',f'901f8ca1:tests/scenario/{old}.py'],text=True)\n original={n.name:n for n in ast.parse(source).body if isinstance(n,ast.FunctionDef)}\n updated=ast.parse((Path('tests/unit')/(new+'.py')).read_text())\n for node in updated.body:\n  if not isinstance(node,ast.FunctionDef) or not node.name.startswith('test_'):continue\n  before=original[node.name]\n  before_body=ast.dump(ast.Module(body=before.body,type_ignores=[]),include_attributes=False)\n  after_body=ast.dump(ast.Module(body=node.body,type_ignores=[]),include_attributes=False)\n  assert before_body==after_body,(old,node.name,'body changed')\n  before_decorators=[ast.dump(n,include_attributes=False) for n in before.decorator_list]\n  after_decorators=[ast.dump(n,include_attributes=False) for n in node.decorator_list]\n  if before_decorators!=after_decorators:\n   assert old=='test_computation_binding_reader'\n   assert repr(before_decorators).replace(\"id='PURPOSES'\",\"id='REVIEW_PURPOSES'\")==repr(after_decorators)\n  rows.append({'from':f'tests/scenario/{old}.py::{node.name}','to':f'tests/unit/{new}.py::{node.name}','body_sha256':hashlib.sha256(before_body.encode()).hexdigest(),'decorators_preserved':True})\nPath('/private/tmp/lexinform-moved-cases.json').write_text(json.dumps(rows,indent=2)+'\\n')\nprint('Preserved function bodies and parametrizations:',len(rows))\n",
