    "driver_source": "import cProfile\nimport json\nimport statistics\nfrom contextlib import closing\nfrom time import perf_counter\nfrom lexinform.adapters.sqlite_repo import SqliteBillRepository\nfrom tests.database import empty_repository, close_test_repositories\nfrom tests.harness import World\n\n\ndef migrate():\n    with closing(SqliteBillRepository(':memory:')) as repository:\n        repository.migrate()\n\n\ndef cached():\n    with closing(empty_repository()):\n        pass\n\n\ndef world():\n    World()\n    close_test_repositories()\n\n\ndef pipeline():\n    w = World()\n    w.add_bill('3039', 'Projekt ustawy o cudzoziemcach')\n    w.run()\n    close_test_repositories()\n\n\nresult = {}\nfor label, function, n in [('migrate', migrate, 50), ('cached_factory', cached, 50), ('world_init', world, 50), ('one_bill_run', pipeline, 20)]:\n    function()\n    batches = []\n    for _ in range(3):\n        started = perf_counter()\n        for _ in range(n):\n            function()\n        batches.append(1000 * (perf_counter() - started) / n)\n        close_test_repositories()\n    result[label] = {'median_ms': statistics.median(batches), 'batches_ms': batches}\nprofiler = cProfile.Profile()\nprofiler.runcall(pipeline)\nprofiler.dump_stats('/private/tmp/lexinform-probe-' + __import__('os').environ['PERF_LABEL'] + '.pstats')\nprint(json.dumps(result, indent=2))\n"
