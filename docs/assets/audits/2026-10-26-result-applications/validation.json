  "size_observer": {
    "path": "out/corpus/j062/result_sizes.py",
    "sha256": "b50cf301f762fe7153d6b8766274fad854cdfd5a620cc9f10b1e7a6037fe8a73",
    "bytes": 2212,
    "source": "import gzip\nimport hashlib\nimport json\nimport sqlite3\nfrom contextlib import closing\nfrom pathlib import Path\n\nfrom lexinform.models import AnalysisRecord\n\nroot = Path('/Users/sobaleu/.codex/worktrees/scan-input-manifests/lexinform')\ndatabase = root / 'out/corpus/j061/production-root/restored.db'\nrows = []\npayloads = []\nwith closing(sqlite3.connect(database.as_uri() + '?mode=ro&immutable=1', uri=True)) as connection:\n    for term, number, raw in connection.execute('SELECT term, number, analysis_json FROM bills WHERE analysis_json IS NOT NULL ORDER BY term, number'):\n        record = AnalysisRecord.model_validate_json(raw)\n        payload = record.model_dump_json().encode()\n        selection = record.selection.model_dump_json().encode()\n        payloads.append(payload)\n        rows.append({'term': term, 'number': number, 'record_bytes': len(payload), 'selection_bytes': len(selection)})\nsizes = sorted(row['record_bytes'] for row in rows)\nassert sizes\npopulation = b'\\n'.join(payloads)\nreport = {\n    'scope': 'Existing current Bill.analysis projections only, not unique paid calls or reconstructed computation history. No writes/backfill.',\n    'database_sha256': hashlib.sha256(database.read_bytes()).hexdigest(),\n    'records': len(rows), 'record_bytes_total': sum(sizes),\n    'concatenated_gzip_bytes': len(gzip.compress(population, mtime=0)),\n    'bytes': {'minimum': sizes[0], 'p50': sizes[(len(sizes)-1)//2], 'p90': sizes[int((len(sizes)-1)*0.9)], 'p95': sizes[int((len(sizes)-1)*0.95)], 'maximum': sizes[-1]},\n    'selection_bytes_total': sum(row['selection_bytes'] for row in rows),\n    'largest': sorted(rows, key=lambda row: row['record_bytes'], reverse=True)[:5],\n    'exclusions': ['No input text/file/request archive estimate.', 'This is not the size of SQL history or a growth forecast.', 'Only current projections are available; superseded historical outputs cannot be counted from them.'],\n}\noutput = root / 'out/corpus/j062/result-sizes.json'\nwith output.open('x') as stream:\n    json.dump(report, stream, indent=2)\n    stream.write('\\n')\nprint(json.dumps({key: report[key] for key in ('records', 'record_bytes_total', 'concatenated_gzip_bytes', 'bytes', 'selection_bytes_total')}))\n"
  },
