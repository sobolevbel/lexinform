    "probe_source": "import sqlite3\nfrom pathlib import Path\n\nimport pytest\nfrom tools import request_doctor\n\nfrom tests.scenario.test_request_doctor import snapshot\nfrom tests.harness import World\n\n\ndef test_writer_starting_after_preflight_invalidates_the_audit(\n    tmp_path: Path, monkeypatch: pytest.MonkeyPatch\n) -> None:\n    world = World()\n    world.add_bill('3039', 'Projekt ustawy o cudzoziemcach')\n    world.run(track=False)\n    path = snapshot(world, tmp_path)\n    read = request_doctor.read_artifact\n    writer: sqlite3.Connection | None = None\n\n    def start_writer(source: Path) -> bytes:\n        nonlocal writer\n        value = read(source)\n        if writer is None:\n            writer = sqlite3.connect(path)\n            writer.execute(\"UPDATE bills SET title=title || ' concurrently changed'\")\n            writer.commit()\n        return value\n\n    monkeypatch.setattr(request_doctor, 'read_artifact', start_writer)\n    try:\n        report = request_doctor.audit(path)\n    finally:\n        if writer is not None:\n            writer.close()\n\n    assert report['status'] == 'failed'\n    assert any(row['code'] == 'database_changed_during_audit' for row in report['findings'])\n",
