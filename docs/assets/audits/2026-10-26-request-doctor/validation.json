    "observer_source": "import hashlib\nimport json\nimport sqlite3\nfrom contextlib import closing\nfrom pathlib import Path\n\nroot = Path('out/corpus/j060/snapshots')\nroot.mkdir()\nsources = {\n    'production': Path('out/corpus/j059/production-state.sql'),\n    'new-receipts': Path('out/corpus/j059/state-current/amendments-completed.sql'),\n    'pending': Path('out/corpus/j059/state-current/supplement-pending.sql'),\n}\nreport = {}\nfor name, source in sources.items():\n    path = root / (name + '.db')\n    raw = source.read_bytes()\n    with closing(sqlite3.connect(path)) as database:\n        database.executescript(raw.decode())\n        assert database.execute('PRAGMA integrity_check').fetchone() == ('ok',)\n        assert not database.execute('PRAGMA foreign_key_check').fetchall()\n    report[name] = {'sql_sha256': hashlib.sha256(raw).hexdigest(), 'database_sha256': hashlib.sha256(path.read_bytes()).hexdigest()}\n(root / 'sources.json').write_text(json.dumps(report, indent=2) + '\\n')\n",
