      "sha256": "08852e316d706008946033308a36213c705e8a0a79a46e68a909492508222074",
      "bytes": 3863,
      "source": "import datetime as dt\nimport gzip\nimport hashlib\nimport json\nimport os\nfrom pathlib import Path\n\nfrom lexinform.models import PublicationKind\nfrom tests.fakes import FakeTextExtractor\nfrom tests.harness import RCL, RPW, WYKAZ, World, rcl_document, rcl_folder, rcl_project, rcl_stage, submission, submission_url\n\n\ndef test_tracking_application_profile():\n    output = Path(os.environ['DA_PROFILE_OUTPUT'])\n    output.mkdir()\n    report = {}\n\n    def snapshot(world, name, numbers):\n        raw = world.repo.dump().encode()\n        (output / f'{name}.sql').write_bytes(raw)\n        without_applications = b'\\n'.join(line for line in raw.splitlines() if not line.startswith(b'INSERT INTO \"result_applications\"'))\n        report[name] = {\n            'sql_bytes': len(raw), 'gzip_bytes': len(gzip.compress(raw, mtime=0)),\n            'sql_sha256': hashlib.sha256(raw).hexdigest(),\n            'without_applications_sha256': hashlib.sha256(without_applications).hexdigest(),\n            'bills_sha256': hashlib.sha256(json.dumps([world.bill(number).model_dump(mode='json') for number in numbers], sort_keys=True).encode()).hexdigest(),\n            'texts_sha256': hashlib.sha256(json.dumps({kind.value:world.publisher.texts(kind) for kind in PublicationKind},sort_keys=True).encode()).hexdigest(),\n            'requests': [{'sha256': hashlib.sha256(request.model_dump_json().encode()).hexdigest(), 'custom_id': request.custom_id, 'payload_sha256': request.payload_sha256, 'cost': request.estimated_cost_usd} for request in world.batch.submitted],\n            'results': sum(len(world.repo.list_computation_results(10, number)) for number in numbers),\n            'applications': sum(len(world.repo.list_result_applications(10, number)) for number in numbers),\n        }\n\n    world = World(profile='production', extractor=FakeTextExtractor(by_content={\n        b'%PDF-orka':'Art. 1. Cudzoziemcy otrzymują poża ru ochronę. '*40,\n        b'%PDF':'Art. 1. Cudzoziemcy otrzymują pożaru ochronę.\\n1) przypis '*40,\n    }))\n    world.gateway.submissions.append(submission())\n    world.gateway.files[submission_url()] = b'%PDF-orka'\n    world.run();world.batch.resolve();world.run()\n    snapshot(world, 'rpw-before', [RPW])\n    world.gateway.submissions[0] = submission(print_number='3100')\n    world.add_bill('3100','Poselski projekt ustawy o zmianie ustawy o udzielaniu cudzoziemcom ochrony')\n    world.touch('3100',dt.datetime(2026,9,8,9,0));world.clock.advance(days=1)\n    world.run();snapshot(world,'rpw-linked',[RPW,'3100'])\n    world.run();snapshot(world,'rpw-repeat',[RPW,'3100'])\n\n    world=World(profile='production')\n    world.add_wykaz_entry();world.run();world.batch.resolve();world.run()\n    snapshot(world,'wykaz-before',[WYKAZ])\n    world.add_rcl_project(rcl_project(wykaz_number='UD408'));world.run()\n    snapshot(world,'wykaz-linked',[WYKAZ,RCL])\n\n    rewritten=b'%PDF-rewritten'\n    world=World(profile='production',extractor=FakeTextExtractor(by_content={rewritten:'Art. 1. Cudzoziemiec składa wniosek o zezwolenie wyłącznie elektronicznie. '*50}))\n    project=world.add_rcl_project();world.run();world.batch.resolve();world.run()\n    snapshot(world,'rcl-before',[RCL])\n    world.clock.advance(days=1);date=dt.date(2026,9,8)\n    document=rcl_document(801,'projekt_po_KP.pdf',created=date)\n    world.add_rcl_project(project.model_copy(update={'stages':(*project.stages[:4],rcl_stage(9,'Stały Komitet Rady Ministrów','reached',modified=date),rcl_stage(10,'Komisja Prawnicza','active',rcl_folder(777,'Projekt',document),modified=date),*project.stages[5:]),'modified':date}))\n    world.rcl.files[document.url]=rewritten;world.run();world.batch.resolve();world.run()\n    snapshot(world,'rcl-applied',[RCL])\n    world.run(full_track=True);snapshot(world,'rcl-repeat',[RCL])\n    (output/'measurements.json').write_text(json.dumps(report,indent=2)+'\\n')\n"
    },
