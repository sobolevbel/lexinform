      "source": "import hashlib\nimport json\nimport os\nimport sqlite3\nfrom contextlib import closing\nfrom pathlib import Path\n\nroot = Path('/Users/sobaleu/.codex/worktrees/scan-input-manifests/lexinform/out/corpus/j063')\noutput = Path(os.environ['DA_SQLITE_OUTPUT'])\noutput.mkdir()\nreport = {}\nfor tag in ('baseline', 'current'):\n    rows = {}\n    for source in sorted((root / f'tracking-{tag}').glob('*.sql')):\n        target = output / f'{tag}-{source.stem}.db'\n        assert not target.exists()\n        with closing(sqlite3.connect(target)) as database, database:\n            database.executescript(source.read_text())\n            assert database.execute('PRAGMA integrity_check').fetchone() == ('ok',)\n            assert not database.execute('PRAGMA foreign_key_check').fetchall()\n        rows[source.stem] = {'sqlite_bytes': target.stat().st_size, 'sha256': hashlib.sha256(target.read_bytes()).hexdigest()}\n    report[tag] = rows\nfor name in report['baseline']:\n    assert report['baseline'][name]['sqlite_bytes'] == report['current'][name]['sqlite_bytes']\nassert report == json.loads((root / 'sqlite-profile.json').read_text())\nwith (output / 'report.json').open('x') as stream:\n    json.dump(report, stream, indent=2)\n    stream.write('\\n')\nprint({'snapshots': sum(map(len, report.values())), 'sqlite_growth': 0, 'integrity': 'ok', 'foreign_key_errors': 0})\n"
