    "path": "out/corpus/j064/checkpoint_profile.py",
    "sha256": "74c07655c044224b99eabca6b424c20915a708b0c5e960461a0bbe1040a2a7ad",
    "bytes": 3627,
    "source": "import gzip\nimport hashlib\nimport json\nimport os\nfrom pathlib import Path\n\nfrom lexinform.models import PublicationKind\nfrom tests.fakes import FakeTextExtractor, make_analysis\nfrom tests.harness import World\nfrom tests.scenario.test_tracking import REPORT_TEXT, REPORT_URL, WITH_REPORT\n\n\ndef test_checkpoint_profile():\n    output = Path(os.environ['DA_PROFILE_OUTPUT']); output.mkdir()\n    report = {}\n\n    def snapshot(world, name, run=None):\n        raw = world.repo.dump().encode(); (output/f'{name}.sql').write_bytes(raw)\n        bill = world.bill('3039'); record = bill.analysis\n        report[name] = {\n            'sql_bytes':len(raw),'gzip_bytes':len(gzip.compress(raw,mtime=0)),\n            'sql_sha256':hashlib.sha256(raw).hexdigest(),'status':bill.status.value,\n            'generation':bill.analysis_generation,'ready':bill.ready_analysis is not None,\n            'answer_sha256':hashlib.sha256(record.analysis.model_dump_json().encode()).hexdigest() if record else None,\n            'record_sha256':hashlib.sha256(record.model_dump_json().encode()).hexdigest() if record else None,\n            'source_checked_at':record.source_checked_at.isoformat() if record and record.source_checked_at else None,\n            'source_url':record.source_url if record else None,\n            'observed':bill.observed_process.model_dump(mode='json') if bill.observed_process else None,\n            'reader_updates_sha256':hashlib.sha256(json.dumps(world.publisher.texts(PublicationKind.STATUS_UPDATE),ensure_ascii=False).encode()).hexdigest(),\n            'reader_updates':world.publisher.texts(PublicationKind.STATUS_UPDATE),\n            'update_count':len(world.publisher.updates),\n            'requests':[{'kind':r.call_kind,'custom_id':r.custom_id,'payload_sha256':r.payload_sha256,'envelope_sha256':hashlib.sha256(r.model_dump_json().encode()).hexdigest(),'cost':r.estimated_cost_usd} for r in world.batch.submitted],\n            'applications':len(world.repo.list_result_applications(10,'3039')),\n            'reanalyzed':run.reanalyzed if run else None,\n        }\n\n    for name in ('sync','batch','batch-wait','batch-wait-new-summary'):\n        batch=name!='sync';wait='wait' in name\n        world=World(profile='production' if batch else 'default',extractor=FakeTextExtractor(by_content={b'%PDF-report':REPORT_TEXT}))\n        world.add_bill('3039','Projekt ustawy o cudzoziemcach');world.run()\n        if batch:world.batch.resolve();world.run()\n        world.set_stages('3039',WITH_REPORT);world.gateway.files[REPORT_URL]=b'%PDF-report';world.clock.advance(days=1)\n        if name.endswith('new-summary'):\n            world.batch.secondary_script[('3039','reanalysis')]=make_analysis(score=4).model_copy(update={'summary':'Новая редакция меняет электронную подачу заявления.','key_changes':['Заявление подаётся электронно.']})\n        if batch:\n            world.run();world.batch.resolve();world.analysis.collect_batches()\n        if wait:world.file_to_print('3039','Do druku nr 3039 - ocena skutków regulacji')\n        first=world.run();snapshot(world,name+'-first',first)\n        if wait:\n            world.batch.resolve();world.clock.advance(hours=1)\n            posted=world.run();snapshot(world,name+'-posted',posted)\n            for attempt in range(3):\n                if world.repo.list_open_llm_batches():\n                    world.batch.resolve();world.clock.advance(hours=1);world.run()\n        world.run();snapshot(world,name+'-settled')\n    (output/'measurements.json').write_text(json.dumps(report,indent=2,ensure_ascii=False)+'\\n')\n"
  },
